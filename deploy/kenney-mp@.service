# systemd template unit: one game server process per prototype.
#   sudo cp deploy/kenney-mp@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kenney-mp@2d kenney-mp@3d
#   journalctl -u kenney-mp@2d -f
#
# Expects the dedicated-server export (tools/export.sh server) at
# /srv/kenney-mp/server/server.x86_64 and a "kenney" system user.

[Unit]
Description=Kenney multiplayer prototype server (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=kenney
WorkingDirectory=/srv/kenney-mp/server
# --bind=127.0.0.1: only Caddy (same host, TLS) talks to the game port.
ExecStart=/srv/kenney-mp/server/server.x86_64 --headless -- --server --game=%i --bind=127.0.0.1
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# The sandbox above leaves no writable home, but Godot creates user:// (and
# its log file) under $HOME/.local/share at startup — and 4.7.1 segfaults if
# it can't. Give each instance its own writable state dir, created by systemd
# and owned by User=: /var/lib/kenney-mp/<game>.
StateDirectory=kenney-mp/%i
Environment=HOME=/var/lib/kenney-mp/%i

[Install]
WantedBy=multi-user.target
